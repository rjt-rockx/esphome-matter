--- /dev/null
+++ b/tests/unit_tests/core/test_entity_extensions.py
@@ -0,0 +1,168 @@
+"""Tests for esphome/core/entity_extensions.py."""
+
+import asyncio
+from types import SimpleNamespace
+from typing import Any
+
+import pytest
+import voluptuous as vol
+
+from esphome import loader
+import esphome.config_validation as cv
+from esphome.core import CORE
+from esphome.core.entity_extensions import (
+    EntityExtension,
+    get_entity_extensions,
+    setup_entity_extensions,
+)
+
+NESTED = cv.Schema(
+    {
+        cv.Optional("endpoint"): cv.int_range(1, 10),
+        cv.Optional("label", default="x"): cv.string,
+    }
+)
+FLAT = cv.Schema(
+    {
+        cv.Optional("report"): cv.boolean,
+        cv.Optional("cluster", default="generic"): cv.string,
+    }
+)
+
+
+def _base() -> cv.Schema:
+    schema = cv.Schema({cv.Optional("name"): cv.string})
+    schema.add_extra(lambda config: {**config, "extra_ran": True})
+    return schema.add_entity_extensions("demo")
+
+
+@pytest.fixture
+def components(monkeypatch: pytest.MonkeyPatch):
+    """Register fake components; returns a function that loads one."""
+    registry: dict[str, list[EntityExtension]] = {}
+    orig = loader.get_component
+
+    def get_component(domain: str, exception: bool = False):
+        if domain in registry:
+            return SimpleNamespace(entity_extensions=registry[domain])
+        return orig(domain, exception)
+
+    monkeypatch.setattr(loader, "get_component", get_component)
+    CORE.loaded_integrations = set()
+
+    def load(name: str, *extensions: EntityExtension) -> None:
+        registry[name] = list(extensions)
+        CORE.loaded_integrations.add(name)
+
+    return load
+
+
+def test_key_rejected_while_owner_not_loaded(components) -> None:
+    components("other")
+    with pytest.raises(vol.MultipleInvalid, match="extra keys not allowed"):
+        _base()({"name": "a", "ext": {"endpoint": 1}})
+
+
+def test_nested_key_validated_and_attached(components) -> None:
+    components("ext", EntityExtension("demo", NESTED, key="ext"))
+    result = _base()({"name": "a", "ext": {"endpoint": 3}})
+    assert result == {
+        "name": "a",
+        "extra_ran": True,
+        "ext": {"endpoint": 3, "label": "x"},
+    }
+    # Absent nested key: the extension stays out of the entity.
+    assert _base()({"name": "a"}) == {"name": "a", "extra_ran": True}
+
+
+def test_only_matching_domain(components) -> None:
+    components("ext", EntityExtension("other_domain", NESTED, key="ext"))
+    assert get_entity_extensions("demo") == []
+    with pytest.raises(vol.MultipleInvalid, match="extra keys not allowed"):
+        _base()({"ext": {}})
+
+
+def test_errors_keep_entity_path_and_combine(components) -> None:
+    components("ext", EntityExtension("demo", NESTED, key="ext"))
+    with pytest.raises(vol.MultipleInvalid) as err:
+        _base()({"name": ["not", "a", "string"], "ext": {"endpoint": 99}})
+    paths = sorted(str(e.path) for e in err.value.errors)
+    assert paths == ["['ext', 'endpoint']", "['name']"]
+
+
+def test_extend_and_nested_sub_entities(components) -> None:
+    components("ext", EntityExtension("demo", NESTED, key="ext"))
+    platform = _base().extend({cv.Optional("speed"): cv.int_})
+    hub = cv.Schema({cv.Optional("child"): platform})
+    result = hub({"child": {"speed": 2, "ext": {"endpoint": 1}}})
+    assert result["child"]["ext"] == {"endpoint": 1, "label": "x"}
+    # Extending a plain schema with the entity schema keeps the hook too.
+    wrapped = cv.Schema({cv.Optional("speed"): cv.int_}).extend(_base())
+    assert wrapped({"ext": {}})["ext"] == {"label": "x"}
+
+
+def test_platform_key_wins(components) -> None:
+    components("ext", EntityExtension("demo", NESTED, key="ext"))
+    platform = _base().extend({cv.Optional("ext"): cv.string})
+    assert platform({"ext": "own"})["ext"] == "own"
+
+
+def test_flat_extension_merges_options_and_defaults(components) -> None:
+    components("flat", EntityExtension("demo", FLAT))
+    result = _base()({"name": "a", "report": "yes"})
+    assert result == {
+        "name": "a",
+        "extra_ran": True,
+        "report": True,
+        "cluster": "generic",
+    }
+
+
+def test_flat_extension_defaults_never_override_platform_options(components) -> None:
+    components("flat", EntityExtension("demo", FLAT))
+    platform = _base().extend({cv.Optional("cluster", default="own"): cv.string})
+    assert platform({"report": True})["cluster"] == "own"
+
+
+def test_flat_collision_between_owners_is_an_error(components) -> None:
+    components("flat_a", EntityExtension("demo", FLAT))
+    components("flat_b", EntityExtension("demo", FLAT))
+    with pytest.raises(vol.MultipleInvalid, match="by both 'flat_a' and 'flat_b'"):
+        _base()({"report": True})
+
+
+def test_validate_sees_merged_config(components) -> None:
+    seen: list[dict[str, Any]] = []
+
+    def validate(config):
+        seen.append(dict(config))
+        if config["ext"].get("endpoint") == 7:
+            raise cv.Invalid("seven is taken", ["ext", "endpoint"])
+        return config
+
+    components("ext", EntityExtension("demo", NESTED, key="ext", validate=validate))
+    _base()({"name": "a", "ext": {"endpoint": 1}})
+    assert seen[0]["extra_ran"] is True
+    assert seen[0]["ext"]["endpoint"] == 1
+    with pytest.raises(vol.MultipleInvalid, match="seven is taken"):
+        _base()({"ext": {"endpoint": 7}})
+
+
+def test_setup_runs_for_configured_entities(components) -> None:
+    calls: list[tuple[Any, ...]] = []
+
+    async def setup(var, config, **kwargs):
+        calls.append((var, config.get("ext"), kwargs))
+
+    components("ext", EntityExtension("demo", NESTED, key="ext", setup=setup))

new file mode 100644
--- /dev/null
+++ b/esphome/core/entity_extensions.py
@@ -0,0 +1,168 @@
+"""Entity extensions: options a component contributes to core entity schemas.
+
+A component that wants per-entity options (``zigbee: endpoint``, a nested
+``matter:`` block, ...) declares them in its module instead of being imported
+by every entity domain::
+
+    ENTITY_EXTENSIONS = [
+        EntityExtension(
+            "switch",
+            MY_SWITCH_SCHEMA,
+            key="my_component",  # nested: ``switch: [{..., my_component: {...}}]``
+            validate=validate_switch,  # optional, sees the whole entity config
+            setup=setup_switch,  # optional, ``await setup(var, config, **kwargs)``
+        ),
+    ]
+
+An extension is only active while its owning component is loaded
+(``CORE.loaded_integrations``), so a config without that component keeps
+rejecting the option as an unknown key. Entity domains opt in with one line
+(``_SWITCH_SCHEMA.add_entity_extensions("switch")``) and one call in their
+setup coroutine (``await setup_entity_extensions("switch", var, config)``).
+
+Because the hook lives on the domain base schema and is copied by
+``Schema.extend()``, it reaches every platform schema built from it, including
+nested sub-entities (``sensor_schema()`` used as a value in a platform schema).
+"""
+
+from __future__ import annotations
+
+from collections.abc import Awaitable, Callable
+import copy
+from dataclasses import dataclass
+from typing import Any
+
+import voluptuous as vol
+
+from esphome.core import CORE
+from esphome.types import ConfigType
+
+
+@dataclass(frozen=True)
+class EntityExtension:
+    """Options one component adds to the entities of one domain.
+
+    ``key`` names a nested mapping (recommended). ``key=None`` merges the
+    schema's options into the entity itself; it exists so integrations that
+    predate this registry (zigbee) keep their YAML, and new users should not
+    use it because flat options collide easily (``endpoint:``).
+    Options the platform schema itself defines always win over an extension.
+    """
+
+    domain: str
+    schema: Any
+    key: str | None = None
+    validate: Callable[[ConfigType], ConfigType] | None = None
+    setup: Callable[..., Awaitable[None]] | None = None
+
+
+def get_entity_extensions(domain: str) -> list[tuple[str, EntityExtension]]:
+    """Return ``(owner, extension)`` for every loaded component extending ``domain``."""
+    from esphome.loader import get_component
+
+    result: list[tuple[str, EntityExtension]] = []
+    for name in sorted(CORE.loaded_integrations):
+        if "." in name or (manifest := get_component(name)) is None:
+            continue
+        result.extend(
+            (name, ext) for ext in manifest.entity_extensions if ext.domain == domain
+        )
+    return result
+
+
+def _schema_keys(schema: Any) -> set[str]:
+    mapping = getattr(schema, "schema", schema)
+    if not isinstance(mapping, dict):
+        raise TypeError("a flat entity extension needs a mapping schema")
+    return {str(key) for key in mapping}
+
+
+def _errors(err: vol.Invalid, path: list[Any]) -> list[vol.Invalid]:
+    err.prepend(path)
+    return list(err.errors) if isinstance(err, vol.MultipleInvalid) else [err]
+
+
+def validate_with_extensions(
+    domain: str,
+    own_keys: set[str],
+    data: ConfigType,
+    validate_entity: Callable[[ConfigType], ConfigType],
+) -> ConfigType:
+    """Validate one entity config of ``domain`` plus the active extensions.
+
+    The extension options are split off first so the entity's own mapping
+    validation never sees them, validated by their owner's schema (errors keep
+    the entity path), and merged back into the validated entity config. Each
+    extension's ``validate`` then runs on the merged config.
+    """
+    active = get_entity_extensions(domain)
+    if not active:
+        return validate_entity(data)
+
+    data = copy.copy(data)
+    errors: list[vol.Invalid] = []
+    validated: list[tuple[EntityExtension, Any]] = []
+    claimed: dict[str, str] = {}
+    for owner, ext in active:
+        if ext.key is not None:
+            keys = {ext.key} - own_keys
+        else:
+            keys = _schema_keys(ext.schema) - own_keys
+        errors.extend(
+            vol.Invalid(
+                f"Option '{key}' is added to {domain} by both "
+                f"'{claimed[key]}' and '{owner}'",
+                [key],
+            )
+            for key in sorted(keys & claimed.keys())
+        )
+        keys -= claimed.keys()
+        claimed.update(dict.fromkeys(keys, owner))
+        if not keys:
+            continue
+        try:
+            if ext.key is not None:
+                if ext.key not in data:
+                    continue
+                validated.append((ext, ext.schema(data.pop(ext.key))))
+            else:
+                raw = {key: data.pop(key) for key in list(data) if key in keys}
+                validated.append((ext, ext.schema(raw)))
+        except vol.Invalid as err:
+            errors.extend(_errors(err, [ext.key] if ext.key is not None else []))
+
+    try:
+        config = validate_entity(data)
+    except vol.MultipleInvalid as err:
+        raise vol.MultipleInvalid(errors + list(err.errors)) from err
+    if errors:
+        raise vol.MultipleInvalid(errors)
+
+    for ext, value in validated:
+        if ext.key is not None:
+            config[ext.key] = value
+        else:
+            # Never let an extension default overwrite a platform-owned option.
+            config.update((k, v) for k, v in value.items() if k not in own_keys)
+    for _, ext in active:
+        if ext.validate is not None:
+            try:
+                config = ext.validate(config)
+            except vol.Invalid as err:
+                raise vol.MultipleInvalid(_errors(err, [])) from err
+    return config
+
+
+async def setup_entity_extensions(
+    domain: str, var: Any, config: ConfigType, **kwargs: Any
+) -> None:
+    """Run the ``setup`` coroutine of every active extension of ``domain``.
+
+    Nested extensions are only set up for entities that carry their key.
+    ``kwargs`` carries domain-specific values (``number`` passes ``min_value``,
+    ``max_value`` and ``step``).
+    """
+    for _, ext in get_entity_extensions(domain):
+        if ext.setup is None or (ext.key is not None and ext.key not in config):
+            continue
+        await ext.setup(var, config, **kwargs)
